# Copy to .env and fill in. NEVER commit .env.

# The image version compose runs. Required — there is deliberately no default.
# Locally the override builds from source, but compose still interpolates this.
TAG=dev

# Postgres superuser-ish owner: creates the database, owns the tables, runs
# Alembic migrations. Used by the db container and by `alembic upgrade`.
DB_HOST=db
DB_PORT=5432
DB_NAME=orbit
DB_USER=orbit
DB_PASSWORD=change-me

# Least-privilege role the web app connects as (DML only, no DDL). Created by
# migration 0002 WITHOUT a password; set one by hand (RUNBOOK §3). Leave both
# blank locally to connect as DB_USER.
DB_APP_USER=
DB_APP_PASSWORD=

# Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 1 in production (HTTPS): Secure cookies + HSTS. 0 locally over plain HTTP.
COOKIE_SECURE=0

# IANA timezone used for "today" (streaks, daily mission), e.g. America/Edmonton.
APP_TIMEZONE=UTC

# Claude features (hints, lab review). Optional — features hide when unset.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_CENTS=500
